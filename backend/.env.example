PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Firebase Admin SDK credentials (preferred — pulled straight from your
# service account JSON's "project_id" / "client_email" / "private_key"
# fields). Wrap the private key in quotes and keep its \n escapes literal.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Fallback: path to a Firebase Admin SDK service account JSON file, used only
# if the three vars above are blank. If none of these are set,
# ./src/config/firebase-service-account.json is used as a last-resort dev fallback.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Claude API key for the AI Setup Concierge and AI Earnings Assistant
# (master-doc.md Section 10, 26). Optional — if left blank, both AI
# features throw a clean AiUnavailableError and the app degrades
# gracefully (Section 10.1/26.7); AI is additive, never a hard dependency.
ANTHROPIC_API_KEY=

# Surfboard payment provider (master-doc.md Section 23) — real
# integration. Leave blank in an environment with no Surfboard account;
# every surfboard.service.js method then throws a clean
# SurfboardUnavailableError, which payment.controller.js/refund.controller.js
# map to 503 PROVIDER_UNAVAILABLE, mirroring ANTHROPIC_API_KEY's
# degrade-gracefully pattern above. API-KEY/API-SECRET/BASE-URL/
# MERCHANT-ID/TERMINAL-ID must all be set together for a real call to be
# made (server-to-server auth: API-KEY + API-SECRET + MERCHANT-ID headers
# on every request).
SURFBOARD_API_BASE_URL=
SURFBOARD_API_KEY=
SURFBOARD_API_SECRET=
SURFBOARD_MERCHANT_ID=
SURFBOARD_STORE_ID=
SURFBOARD_TERMINAL_ID=

# Webhook signing certificate — HMAC-SHA512, Base64-encoded, header
# `x-webhook-signature` (Section 22.5, 24 — signature-verified, not a
# Firebase JWT). Generated once in the Surfboard Console (Console >
# Webhooks > Add new Webhook) and shown only once. This is a real security
# boundary: if left blank, the webhook endpoint responds 503 rather than
# silently skipping verification.
SURFBOARD_WEBHOOK_CERTIFICATE=

# Where the customer lands after completing/failing payment on Surfboard's
# hosted Payment Page — PayLink's own frontend origin (e.g.
# http://localhost:5173 in dev). Defaults to http://localhost:5173 if unset.
SURFBOARD_REDIRECT_BASE_URL=

# Per-order dynamic webhook target (controlFunctions.callBackUrl — see
# guides/online-payments/integrations/webhooks.md's "dynamic URL flow"),
# an alternative to registering a static webhook in the Surfboard Console.
# LEAVE BLANK until this app is deployed to a public HTTPS domain — a
# localhost URL here is unreachable from Surfboard's servers, so
# surfboard.service.js simply omits the field while this is unset. Once
# deployed: set this to https://<your-public-domain>/api/webhooks/surfboard,
# same signature verification applies (SURFBOARD_WEBHOOK_CERTIFICATE above).
SURFBOARD_CALLBACK_URL=

# Minutes an order may sit at payment.status "initiated" before
# jobs/paymentReconciliation.job.js re-checks it directly with Surfboard
# (Section 23.4). Defaults to 30 if unset.
PAYMENT_RECONCILIATION_TIMEOUT_MINUTES=

# How often (seconds) server.js runs the reconciliation poll in the
# background — the PRIMARY way pending payments resolve to paid/failed
# right now, since live webhook delivery needs the public URL above (not
# yet deployed). Defaults to 60 if unset.
PAYMENT_RECONCILIATION_POLL_INTERVAL_SECONDS=

# Comma-separated payment methods actually ACTIVATED for this Surfboard
# merchant account (a subset of what surfboard.service.js's
# PAYMENT_METHOD_MAP merely knows how to translate — that's what Surfboard's
# API understands in general, this is what's turned on for THIS account).
# Live-verified against the real demo account: only CARD is activated today
# (Swish is not). Drives both payment.service.js's validation (rejects a
# not-yet-activated method before ever calling Surfboard) and the frontend's
# payment-method picker via GET /api/config/payment-options. Defaults to
# "card" if unset. Widen later (e.g. "card,swish") once activated in the
# Surfboard Console — just update this and restart, no code change needed.
SURFBOARD_ACTIVE_PAYMENT_METHODS=

# Comma-separated order currencies actually ACCEPTED for this Surfboard
# merchant account. Live-verified: EUR/NOK both fail with a real Surfboard
# error (OR_0004: currency code not associated with this merchant) — only
# SEK works today. Drives product.service.js's catalog-item currency
# validation and the frontend's currency selectors via
# GET /api/config/payment-options. Defaults to "SEK" if unset. Widen later
# (e.g. "SEK,EUR") once accepted in the Surfboard Console — just update this
# and restart, no code change needed.
SURFBOARD_ACTIVE_CURRENCIES=

# Admin authentication (master-doc.md Section 24.4-24.7) — Admin does NOT use
# Firebase Authentication at all: a simple Access Code + Password pair,
# checked directly against these two values, plus a separate
# ADMIN_JWT_SECRET the backend signs its own short-lived admin session token
# with (adminAuth.middleware.js / auth.service.js's handleAdminLogin).
#
# WARNING — DEVELOPMENT-ONLY PLACEHOLDER, NOT A PRODUCTION DESIGN (quoting
# Section 24.4 directly): "Shipping the hardcoded pandisabi/pandisabi pair to
# production would be a critical security failure." Before any real
# deployment this must be replaced with one of: a securely hashed,
# database-stored admin credential set (bcrypt/argon2, never plaintext); a
# proper identity provider used only internally for admin, with no public
# sign-up route ever exposed; or an internal SSO/IAM system if PayLink ever
# has more than a handful of admin operators. ADMIN_JWT_SECRET must also be
# rotated to a freshly generated value and never committed to source control
# — leaving it blank is a real vulnerability, not just an incomplete config.
ADMIN_ACCESS_CODE=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# Days a merchant may sit at `pending_setup` (never finished onboarding)
# before jobs/onboardingReminder.job.js's poll considers it stale enough to
# send an `onboarding_reminder` notification (Phase 13, master-doc.md
# Section 27's scoped-down "Reminder" event — see that job file's header
# for why). Defaults to 3 if unset. Not wired to any scheduler yet — see
# the same file for the scoping note (mirrors jobs/paymentReconciliation.job.js).
ONBOARDING_REMINDER_STALE_DAYS=
