rules_version = '2';

// Defense-in-depth baseline (final production audit, Section 28.3/19.2) —
// NOT currently load-bearing for authorization: every read/write in this
// app goes through the Express backend, which uses the Firebase Admin SDK
// (backend/src/config/firebase.js) and therefore bypasses these rules
// entirely. Real authorization lives in the Express middleware/service
// layers (authMiddleware, requireRole, assertOwnership — see
// backend/src/utils/ownership.js and every *.service.js's getMerchant()).
//
// This file exists so that if a Firebase project ever reverts to (or is
// left in) permissive "test mode" rules, or a future change accidentally
// adds a client-side Firestore call the frontend doesn't have today
// (confirmed: frontend/src never imports firebase/firestore, only
// firebase/auth), there is a committed, reviewable deny-all baseline to
// catch that regression instead of silently allowing direct client access
// to every collection. Deploy with:
//   firebase deploy --only firestore:rules --project <your-project-id>
match /databases/{database}/documents {
  match /{document=**} {
    allow read, write: if false;
  }
}
