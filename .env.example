# ==============================================================================
# PayLink — Consolidated Monorepo Env Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Firebase Admin SDK credentials (optional - fallback to service account JSON file)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Fallbacks for Firebase Admin SDK
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Surfboard payment provider integration
SURFBOARD_API_BASE_URL=https://carbon.surfgw.com/api
SURFBOARD_API_KEY=
SURFBOARD_API_SECRET=
SURFBOARD_MERCHANT_ID=
SURFBOARD_STORE_ID=
SURFBOARD_TERMINAL_ID=
SURFBOARD_WEBHOOK_CERTIFICATE=
SURFBOARD_REDIRECT_BASE_URL=http://localhost:5173
SURFBOARD_CALLBACK_URL=

# Scoping/Interval Settings
PAYMENT_RECONCILIATION_TIMEOUT_MINUTES=30
PAYMENT_RECONCILIATION_POLL_INTERVAL_SECONDS=60
ONBOARDING_REMINDER_STALE_DAYS=3

# Comma-separated active methods and currencies
SURFBOARD_ACTIVE_PAYMENT_METHODS=card
SURFBOARD_ACTIVE_CURRENCIES=SEK

# Admin credentials for dashboard access
ADMIN_ACCESS_CODE=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# AI Provider Configurations (OpenRouter, Gemini, Anthropic)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000/api
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_USE_FIREBASE_EMULATOR=false
