# Backend API base URL
VITE_API_BASE_URL=http://localhost:4000/api

# Mailto address for the Help page's "Contact Support" button (master-doc.md
# Section 14.13) — not an API call, just where the mail client points.
VITE_SUPPORT_EMAIL=support@paylink.app

# Firebase Client SDK (Project Settings -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Web Push VAPID public key (Firebase Console > Project Settings > Cloud
# Messaging > Web configuration > "Generate key pair"). Required for FCM
# push notifications (Phase 13) to work — blank means push registration
# degrades gracefully with no delivery, same pattern as this project's other
# optional integrations.
VITE_FIREBASE_VAPID_KEY=

# Firebase Emulator (Development Only)
VITE_USE_FIREBASE_EMULATOR=false
